  "counter_reset": {
    "class": "counter-reset",
    "difference": 60.208280668959254,
    "explanation": "The page divides two instantaneous counter values, so as soon as the numerator restarts it reports acceptance since that reset \u2014 here 0.086% against a true 80%, and it keeps decaying. rate() puts the dropped back, so the panel reads 60.295% and stays there. The page's figure never recovers: a lifetime division has no window to forget into, which is the whole reason the tile was deleted rather than tuned.",
    "observed": {
      "fixture": "http://127.0.0.1:8113",
      "fixture_age_s": 1712.36,
      "page_cache_hit_pct": 0.9660997338886961,
      "page_lifetime_pct": 0.08645617314601162,
      "panel_cache_hit_pct": 87.15232385159807,
      "panel_windowed_pct": 60.294736842105266,
      "panel_windows_pct": {
        "15m": 59.907344632768364,
        "1m": 59.199999999999996,
        "5m": 60.294736842105266
      },
      "truth_cache_hit_pct": 90.0
    },
    "proof": "monitor/tests/mock_upstream.py --mode reset: draft_tokens_accepted_total restarts every 45 s under a draft_tokens_total that keeps climbing, so the truth is 80% by construction and stays 80% while the scraped counters do not",
    "truth_pct": 80.0,
    "what": "a counter that restarts: rate() adds the pre-reset tokens back into the window, a division of two lifetime counters silently treats the restart as a shorter lifetime and reads low forever after"
  },
