# Alert threshold values — the single place to tune the rules per box.
#
# rules.yml is GENERATED: edit this file (or monitoring/.env, which overrides
# it), then run `python3 monitoring/render_rules.py` and commit both files. CI
# runs `render_rules.py --check` and fails if the committed rules.yml does not
# match these values, so the thresholds below are the real ones, not the ones
# someone tweaked in a running container.
#
# Duration values are Prometheus durations (30s, 2m, 1h). Ratios are 0..1.

# --- availability -----------------------------------------------------------
# The target itself is unreachable / not answering /metrics.
SERVER_DOWN_FOR=2m
# No model-server metrics in the database at all: the server answers /metrics
# with 404/JSON, or nothing scrapes it. The monitor page still works.
METRICS_ABSENT_FOR=5m
# A target that is "up" but whose samples have stopped advancing.
STALE_TARGET_SECONDS=120

# --- the monitor itself (llm_monitor_* from the /metrics passthrough) -------
# How long the passthrough must fail before we say the monitor is broken.
SCRAPE_FAIL_FOR=5m
# How long the monitor may be absent from the database before we say it is down
# (nothing is scraping the passthrough at all, so its history is going stale).
MONITOR_ABSENT_FOR=10m
# Any unparsable exposition line inside this window is a bug worth a page: the
# server changed its /metrics shape and the parsed views are now lying.
PARSE_ERROR_WINDOW=10m

# --- KV cache pressure ------------------------------------------------------
# > warn: eviction storms start; requests begin waiting for KV space.
KV_PRESSURE_WARN=0.90
KV_PRESSURE_WARN_FOR=5m
# > critical: prefill thrash, the server is spending its time evicting.
KV_PRESSURE_CRITICAL=0.97
KV_PRESSURE_CRITICAL_FOR=2m

# --- queueing ---------------------------------------------------------------
# Any deferred request for this long means the server is over its context budget.
QUEUEING_FOR=5m

# --- decode throughput collapse --------------------------------------------
# Fires when the decode rate falls below FRACTION of its own baseline, the
# baseline being the mean of the same rate over BASELINE. Requires at least
# MIN_TOKENS_PER_SECOND of historical traffic, otherwise a box that was idle all
# hour would "collapse" to zero every time it stopped doing work.
THROUGHPUT_COLLAPSE_FRACTION=0.5
THROUGHPUT_COLLAPSE_WINDOW=15m
THROUGHPUT_COLLAPSE_BASELINE=1h
THROUGHPUT_COLLAPSE_STEP=5m
THROUGHPUT_COLLAPSE_FOR=10m
THROUGHPUT_COLLAPSE_MIN_TOKENS_PER_SECOND=1

# --- prompt cache -----------------------------------------------------------
# Hit ratio below this for this long usually means something restarted, the KV /
# prompt cache is too small for the working set, or slots are thrashing.
PROMPT_CACHE_COLD_RATIO=0.20
PROMPT_CACHE_COLD_FOR=15m
# The ratio is meaningless without traffic; require this many prompt tok/s.
PROMPT_CACHE_MIN_PROMPT_TOKENS_PER_SECOND=1
