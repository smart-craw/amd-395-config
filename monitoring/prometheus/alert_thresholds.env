# Alert threshold values — the single place to tune the rules per box.
#
# rules.yml is GENERATED: edit this file (or monitoring/.env, which overrides
# it), then run `python3 monitoring/render_rules.py` and commit both files. CI
# runs `render_rules.py --check` and fails if the committed rules.yml does not
# match these values, so the thresholds below are the real ones, not the ones
# someone tweaked in a running container.
#
# Duration values are Prometheus durations (30s, 2m, 1h). Ratios are 0..1.

# --- availability -----------------------------------------------------------
# The target itself is unreachable / not answering /metrics.
SERVER_DOWN_FOR=2m
# No model-server metrics in the database at all: the server answers /metrics
# with 404/JSON, or nothing scrapes it. The monitor page still works.
METRICS_ABSENT_FOR=5m
# A target that is "up" but whose samples have stopped advancing.
STALE_TARGET_SECONDS=120

# --- the monitor itself (llm_monitor_* from the /metrics passthrough) -------
# How long the passthrough must fail before we say the monitor is broken.
SCRAPE_FAIL_FOR=5m
# How long the monitor may be absent from the database before we say it is down
# (nothing is scraping the passthrough at all, so its history is going stale).
MONITOR_ABSENT_FOR=10m
# Any unparsable exposition line inside this window is a bug worth a page: the
# server changed its /metrics shape and the parsed views are now lying.
PARSE_ERROR_WINDOW=10m

# --- KV cache pressure ------------------------------------------------------
# > warn: eviction storms start; requests begin waiting for KV space.
KV_PRESSURE_WARN=0.90
KV_PRESSURE_WARN_FOR=5m
# > critical: prefill thrash, the server is spending its time evicting.
KV_PRESSURE_CRITICAL=0.97
KV_PRESSURE_CRITICAL_FOR=2m

# --- queueing ---------------------------------------------------------------
# Any deferred request for this long means the server is over its context budget.
QUEUEING_FOR=5m

# --- decode throughput collapse --------------------------------------------
# Fires when the decode rate falls below FRACTION of its own baseline, the
# baseline being the mean of the same rate over BASELINE. Requires at least
# MIN_TOKENS_PER_SECOND of historical traffic, otherwise a box that was idle all
# hour would "collapse" to zero every time it stopped doing work.
THROUGHPUT_COLLAPSE_FRACTION=0.5
THROUGHPUT_COLLAPSE_WINDOW=15m
THROUGHPUT_COLLAPSE_BASELINE=1h
THROUGHPUT_COLLAPSE_STEP=5m
THROUGHPUT_COLLAPSE_FOR=10m
THROUGHPUT_COLLAPSE_MIN_TOKENS_PER_SECOND=1

# --- prompt cache -----------------------------------------------------------
# Hit ratio below this for this long usually means something restarted, the KV /
# prompt cache is too small for the working set, or slots are thrashing.
PROMPT_CACHE_COLD_RATIO=0.20
PROMPT_CACHE_COLD_FOR=15m
# The ratio is meaningless without traffic; require this many prompt tok/s.
PROMPT_CACHE_MIN_PROMPT_TOKENS_PER_SECOND=1

# --- host + GPU telemetry (node_exporter --collector.drm, job "host") --------
# These read the amdgpu **kernel driver's** sysfs (GTT/VRAM bytes, gpu_busy_percent)
# and the hwmon sensors, so they need no ROCm and no root. The whole set is
# documented in monitoring/README.md ("Host + GPU telemetry") and the runbook
# entry "The box ran out of GTT".
#
# NOTHING HERE IS EXPOSED BEYOND LOOPBACK: the exporter binds 127.0.0.1:9100 and
# the scrape target is the host through the docker host-gateway
# (prometheus/targets/host.json). If the GPU panels are empty, `up{job="host"}`
# is the first thing to look at, not these numbers.

# How long the exporter may be missing from the database before it is called down.
# A box without the exporter deployed at all fires this on purpose — deploying
# monitoring/node-exporter.service is the fix, not silencing it.
NODE_EXPORTER_ABSENT_FOR=10m
# Any collector of node_exporter's failing for this long. The interesting one is
# `collector="drm"`: the classic cause is an exporter containerised with only
# /sys/class/drm mounted, where the card0/device symlink dangles and the whole
# card vanishes (verified in workspace-szw.10).
NODE_COLLECTOR_FAIL_FOR=10m
# The drm collector reporting success while exposing no GPU at all (card gone,
# module reloaded, BIOS change) — the case `node_scrape_collector_success` cannot
# see, because a collector that finds no card succeeded and simply has nothing to
# say.
NODE_GPU_TELEMETRY_ABSENT_FOR=15m

# --- GTT: the pool the model actually grows ----------------------------------
# On a shared-memory APU the model's weights and KV cache are GTT (TTM)
# allocations, so gtt_used grows with the model and gtt_total is the
# `amdgpu.gttsize=` from the root README. VRAM is the BIOS carve-out and is
# deliberately NOT alerted on: it barely moves on this box.
#
# GTT_PRESSURE_WARN is the one number on this box that must be re-tuned from
# measurement rather than from a guess: run
#   promtool query instant http://127.0.0.1:9090 'host:gtt_usage_ratio:max_2d'
# after the rule has had >= 2 days of traffic (monitoring/collect_host_baseline.sh
# prints it for you) and set this ~0.03 above the highest steady-state value, so
# it says "something grew beyond how you use this box" instead of paging at 02:00
# for normal work. The shipped default is the near-ceiling value it is safe to run
# before that baseline exists.
GTT_PRESSURE_WARN=0.95
GTT_PRESSURE_WARN_FOR=15m
# Baseline-free companion alert, so a fresh box is not unprotected while the
# 2-day baseline fills in: at the current growth rate, the GTT pool is exhausted
# within HORIZON seconds. Slope over SLOPE_WINDOW, so a steady model that is not
# growing cannot fire it.
GTT_EXHAUSTION_SLOPE_WINDOW=30m
GTT_EXHAUSTION_HORIZON=600
GTT_EXHAUSTION_FOR=5m

# --- GPU thermals ------------------------------------------------------------
# Alerted on the *hottest* amdgpu hwmon sensor (max over the chip's sensors),
# which on this part is the junction/hotspot rather than the edge sensor — and
# the sensor names on gfx1151 are only known on the box, which is why the
# selector does not name temp1/temp2. The numbers below come from the part's
# junction maximum (~100 C on this class), not from a baseline, and the GPU
# panel draws the same two bands.
# Note: node_exporter exports an unreadable attribute as 0 (see the findings
# note), so a LOW reading can mean "could not ask"; a HIGH one is always real.
GPU_TEMP_WARN=95
GPU_TEMP_WARN_FOR=10m
GPU_TEMP_CRITICAL=100
GPU_TEMP_CRITICAL_FOR=5m

# --- memory pressure (PSI) ---------------------------------------------------
# GTT is system RAM, so GPU memory exhaustion and host memory exhaustion are the
# same event seen from two places. These are stall fractions: 0.10 means at least
# one task was stalled waiting for memory for 10 % of the wall clock in the
# window. Thresholds are the usual "reclaim is hurting latency" / "thrashing" pair;
# host:psi_memory_waiting_ratio:max_2d is recorded for the same re-tune recipe as
# GTT above.
PSI_MEMORY_WINDOW=5m
PSI_MEMORY_WAIT_WARN=0.10
PSI_MEMORY_WAIT_WARN_FOR=10m
PSI_MEMORY_WAIT_CRITICAL=0.25
PSI_MEMORY_WAIT_CRITICAL_FOR=5m
